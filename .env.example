# ── Supabase ──────────────────────────────────────
# Project Settings → API 取得。

# https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_URL=

# anon / publishable key。會送到瀏覽器，靠 RLS 保護。
NUXT_PUBLIC_SUPABASE_KEY=

# service_role / secret key。只能在 Server 使用，絕對不可外流。
NUXT_SUPABASE_SECRET_KEY=

# ── 藍新金流（NewebPay）────────────────────────────
# 商店後台取得。目前只串測試環境 ccore.newebpay.com。

NUXT_NEWEBPAY_MERCHANT_ID=

# HashKey 必須剛好 32 bytes，HashIV 必須剛好 16 bytes，
# 長度不符時 server/utils/newebpay.ts 會直接丟錯。
NUXT_NEWEBPAY_HASH_KEY=
NUXT_NEWEBPAY_HASH_IV=

# 藍新背景通知網址。必須是 https、不能帶帳號密碼、
# 443 以外的埠號會被 prepare.post.ts 拒絕。
# 例：https://mytool-mybb.vercel.app/api/payments/notify
NUXT_NEWEBPAY_NOTIFY_URL=
